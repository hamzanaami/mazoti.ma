# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data (rebuild with the pipeline; never commit licensed or raw data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Secrets and local config
.env
.env.*
*.key

# OS / editor
.DS_Store
.idea/
.vscode/

# LaTeX build files (keep .tex and the final .pdf)
docs/latex/*.aux
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc
docs/latex/*.fls
docs/latex/*.fdb_latexmk
docs/latex/build.log
